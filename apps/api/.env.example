NODE_ENV=development
PORT=3100
DATABASE_URL=postgresql://huellitas:huellitas@localhost:5433/huellitas
# e2e: base aparte, se resetea en cada corrida
TEST_DATABASE_URL=postgresql://huellitas:huellitas@localhost:5433/huellitas_test
# openssl rand -base64 48
JWT_ACCESS_SECRET=cambiame-por-un-secreto-de-al-menos-32-caracteres
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
# Client IDs de Google Cloud (web, android, ios), separados por coma
GOOGLE_CLIENT_IDS=
# Orígenes permitidos (web). Vacío en dev = todos
CORS_ORIGINS=
DEFAULT_CITY_SLUG=leones-cba
# URL pública de la web (links compartidos y mensaje de WhatsApp)
PUBLIC_WEB_URL=http://localhost:3101
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Fotos: local (disco, desarrollo) | r2 (Cloudflare R2)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Dominio público del bucket (custom domain o r2.dev)
R2_PUBLIC_BASE_URL=
